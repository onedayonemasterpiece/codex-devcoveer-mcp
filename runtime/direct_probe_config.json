{
  "version": 1,
  "projects": {
    "codex-devcoveer-mcp": {
      "github_repo": "onedayonemasterpiece/codex-devcoveer-mcp",
      "remotes": {
        "origin": "onedayonemasterpiece/codex-devcoveer-mcp"
      },
      "executables": {
        "gh": "/usr/local/bin/gh"
      },
      "services": {
        "mcp_tunnel": {
          "unit": "codex-devserver-tunnel.service",
          "scope": "user",
          "ports": [
            18080
          ],
          "direct_actions": [
            "start",
            "restart",
            "enable_start"
          ]
        },
        "opencode": {
          "unit": "opencode-devcoveer.service",
          "scope": "user",
          "ports": [
            4097
          ],
          "direct_actions": [
            "start"
          ]
        },
        "giga1": {
          "unit": "gpt2giga-giga1.service",
          "scope": "user",
          "ports": [
            8091
          ],
          "direct_actions": [
            "start",
            "restart",
            "enable_start"
          ]
        },
        "browser_tunnel": {
          "unit": "my-browser-bridge-tunnel.service",
          "scope": "user",
          "ports": [
            8081
          ],
          "direct_actions": [
            "start",
            "restart",
            "enable_start"
          ]
        }
      },
      "logs": {
        "mcp_tunnel": {
          "type": "journal",
