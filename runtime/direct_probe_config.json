        "opencode": {
          "type": "journal",
          "service": "opencode"
        },
        "giga1": {
          "type": "journal",
          "service": "giga1"
        },
        "browser_tunnel": {
          "type": "journal",
          "service": "browser_tunnel"
        }
      },
      "roots": {
        "source": "/home/dev/projects/codex-devcoveer-mcp",
